# Qdrant — векторная база данных
# Для контейнера RAG service (внутри Docker сети): http://qdrant:6333
# Для подключения с хоста (localhost): http://localhost:6333
# В docker-compose.yml для сервиса app установлено http://qdrant:6333
QDRANT_URL=http://localhost:6333
# API-ключ для подключения к Qdrant (если настроен на сервере)
QDRANT_API_KEY=your-secret-api-key-here
# Обязательно: укажите API-ключ для защиты RAG-сервиса
RAG_SERVICE_API_KEY=your-secret-api-key-here
# Список инструментов MCP, которые разрешено вызывать через /mcp (через запятую).
# Оставьте пустым, чтобы разрешить все зарегистрированные инструменты.
#
# Доступные инструменты (имя для включения указывайте точно в ALLOWED_MCP_TOOLS):
#   search_documents_tool
#       Описание: семантический поиск по документам. Параметры: query_text, collection_name, limit, filter, include_old_versions.
#       Пример включения: ALLOWED_MCP_TOOLS=search_documents_tool
#   search_categories_tool
#       Описание: семантический поиск по иерархии категорий. Параметры: query_text, limit.
#       Пример включения: ALLOWED_MCP_TOOLS=search_categories_tool
#   get_category_hierarchy_tool
#       Описание: получение иерархии категорий с количеством чанков. Параметры: collection_name, depth, categories.
#       Пример включения: ALLOWED_MCP_TOOLS=get_category_hierarchy_tool
#
# Примеры конфигурации:
#   Разрешить только поиск по документам и категориям:
#     ALLOWED_MCP_TOOLS=search_documents_tool,search_categories_tool
#   Разрешить все инструменты (по умолчанию):
#     ALLOWED_MCP_TOOLS=
ALLOWED_MCP_TOOLS=search_documents_tool,search_categories_tool

# Имя коллекции в Qdrant для хранения основных документов по умолчанию
DEFAULT_COLLECTION=documents
# Вес семантического (векторного) поиска в гибридном поиске (0.0–1.0)
SEMANTIC_WEIGHT=0.3
# Вес поиска по категориям в гибридном поиске (0.0–1.0)
CATEGORY_WEIGHT=0.7
# Включить взвешенный RRF (Reciprocal Rank Fusion) для гибридного поиска
ENABLE_WEIGHTED_RRF=true

# Веса для итогового score в grouped_search
# document_weight: вес максимального скор чанка документа (0.0–1.0)
# category_weight_final: вес семантического скор категории (0.0–1.0)
# Итоговый score = doc_score * document_weight + category_score * category_weight_final
DOCUMENT_WEIGHT=0.4
CATEGORY_WEIGHT_FINAL=0.6

# Модель эмбеддингов
# Доступные модели:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (лёгкая, ~80 МБ)
#   BAAI/bge-m3 (универсальная, ~2.2 ГБ, поддерживает 100+ языков)
EMBEDDING_MODEL=BAAI/bge-m3

# Использовать GPU для векторизации (требуется NVIDIA GPU с поддержкой CUDA)
# В Docker-режиме необходимо раскомментировать секцию deploy в docker-compose.yml
USE_GPU=false

# Офлайн-режим: не обращаться к Hugging Face Hub (1 = офлайн, 0 = онлайн)
# При офлайн-развёртывании модель должна быть предварительно загружена в model_cache/
HF_HUB_OFFLINE=1

# Логирование: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Адрес и порт сервиса
# SERVICE_HOST: интерфейс, на котором сервис слушает запросы (0.0.0.0 = все интерфейсы)
# SERVICE_PORT: порт для HTTP-запросов (должен совпадать с портом в docker-compose ports)
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# Параметры поиска
# Максимальное количество результатов при поиске документов
SEARCH_LIMIT=10

# Параметры загрузки
# Количество документов для пакетной обработки при загрузке
UPLOAD_BATCH_SIZE=10
# Максимальный размер загружаемого файла в МБ
MAX_FILE_SIZE_MB=50
# Разрешённые MIME-типы загружаемых файлов (через запятую)
ALLOWED_MIME_TYPES=text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/html,text/markdown

# Параметры чанкинга
# Размер текстового фрагмента (chunk) в символах при разбиении документов
CHUNK_SIZE=1024
# Перекрытие между соседними фрагментами в символах (для сохранения контекста)
CHUNK_OVERLAP=50

# Категории
# Имя коллекции в Qdrant для хранения категорий документов
CATEGORY_COLLECTION=categories
# Коэффициент усиления поиска по категориям (0.0 — отключено, 1.0 — максимальное усиление)
CATEGORY_BOOST_FACTOR=0.5
# Режим усиления: multiply (умножение скором) или add (сложение скоров)
CATEGORY_BOOST_MODE=multiply

# Docling — конвертация документов в Markdown (PDF, DOCX, HTML, изображения)
# Распознаёт структуру, таблицы, изображения и описывает содержимое скриншотов
# Вкл/выкл Docling (true — использовать Docling, false — legacy алгоритмы)
USE_DOCLING=true
# OCR движок: tesseract (через системный tesseract-ocr CLI), rapidocr, easyocr
DOCLING_OCR_ENGINE=tesseract
# Вкл/выкл OCR для сканированных документов и изображений
DOCLING_DO_OCR=true
# Модель для описания содержимого изображений (опционально, оставить пустым для отключения)
# Пример: "Salesforce/blip-image-captioning-base"
DOCLING_IMAGE_DESCRIPTION_MODEL=