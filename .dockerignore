# Игнорируем виртуальное окружение
venv/
.venv/
env/

# Игнорируем кэш Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Игнорируем файлы IDE
.vscode/
.idea/

# Игнорируем Git
.git/
.gitignore

# Игнорируем Qwen
.qwen/

# Игнорируем логи
*.log

# Игнорируем системные файлы
.DS_Store
Thumbs.db

# Игнорируем секреты
.env

# Игнорируем данные, которые создаются в runtime
uploads/
qdrant_data/

# Кэш моделей (подключается через volume mount, не включается в образ)
model_cache/

# Утилиты для Windows (не нужны в Linux-контейнере)
poppler/

# Скрипты запуска/развёртывания (не нужны внутри контейнера)
*.ps1

# Игнорируем distrib
distrib/

# Игнорируем документацию
*.md
README*
LICENSE*